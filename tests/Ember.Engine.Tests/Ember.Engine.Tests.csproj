    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ember.Engine\Ember.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\CharacterStudio\Assets\TextureCoordinateTest.glb"
