<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CharacterStudio</RootNamespace>
    <AssemblyName>CharacterStudio</AssemblyName>
    <MonoGamePlatform>Windows</MonoGamePlatform>
    <EnableRpgAuthoringModule Condition="'$(EnableRpgAuthoringModule)' == ''">true</EnableRpgAuthoringModule>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ember.Editor\Ember.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\TextureCoordinateTest.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fox.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ReleaseACourtyard.glb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\InteractionChime.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\RpgPlacementDefinitions.json" CopyToOutputDirectory="PreserveNewest" Condition="'$(EnableRpgAuthoringModule)' == 'true'" />
    <Content Include="Scenes\ReleaseAShowcase.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scenes\FilmStarter.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\CharacterStudio.mgcb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableRpgAuthoringModule)' == 'true'">
    <ProjectReference Include="..\..\src\Ember.Editor.Rpg\Ember.Editor.Rpg.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyRpgAuthoringModule" AfterTargets="Build"
          Condition="'$(EnableRpgAuthoringModule)' == 'true'">
    <ItemGroup>
      <RpgAuthoringModuleFile Include="..\..\src\Ember.Editor.Rpg\bin\$(Configuration)\net9.0-windows\*.dll" />
      <RpgAuthoringModuleFile Include="..\..\src\Ember.Editor.Rpg\bin\$(Configuration)\net9.0-windows\*.deps.json" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Modules" />
    <Copy SourceFiles="@(RpgAuthoringModuleFile)" DestinationFolder="$(OutDir)Modules"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
