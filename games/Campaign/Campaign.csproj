<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Campaign</RootNamespace>
    <AssemblyName>Campaign</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ember.Engine\Ember.Engine.csproj" />
    <ProjectReference Include="..\..\src\Ember.Scripting\Ember.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Content\Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content\Audio\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PlayBot.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
