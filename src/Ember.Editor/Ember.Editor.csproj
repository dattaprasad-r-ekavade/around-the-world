<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Ember.Editor</RootNamespace>
    <AssemblyName>Ember.Editor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ember.Engine\Ember.Engine.csproj" />
    <ProjectReference Include="..\Ember.Authoring\Ember.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fonts\SourceSans3-Regular.ttf" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Fonts\SourceSans3-LICENSE.md" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

</Project>
